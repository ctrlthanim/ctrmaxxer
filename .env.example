# Copy to .env and fill in. Never commit .env.

# Creator Hub -> Open Cloud -> API Keys. Grant: ad.campaign:read, ad.campaign:write, ad.billing:read,
# asset:read, asset:write, and universe.analytics:read for your experience.
ROBLOX_API_KEY=

# Who owns the uploaded ad images: set ONE of these
ROBLOX_CREATOR_USER_ID=
ROBLOX_CREATOR_GROUP_ID=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Discord channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
# Several channels: separate the URLs with commas.
DISCORD_WEBHOOK_URL=
